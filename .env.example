# Client (Vite) — safe to expose in browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server — used by TanStack server functions and webhook routes
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (server-only)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Web push (server) — generate a new pair before going live; these identify your
# origin to the push services, and rotating them invalidates every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@courthub.app

# Web push (client) — must be the SAME public key as VAPID_PUBLIC_KEY above.
VITE_VAPID_PUBLIC_KEY=

# Notification email (server). Without RESEND_API_KEY, email is skipped rather than
# retried, so a dev environment needs no mail credentials.
RESEND_API_KEY=
# Defaults to Resend's shared sender, which delivers ONLY to the email that owns
# your Resend account. Set this to your own verified domain to reach real players.
NOTIFICATION_FROM_EMAIL=CourtHub <onboarding@resend.dev>

# Shared secret for POST /api/internal/notifications/drain, sent as x-drain-secret.
NOTIFICATION_DRAIN_SECRET=

# Absolute origin used for links inside emails and pushes. Falls back to the request
# origin, which is wrong behind a proxy — set it in production.
APP_URL=https://courthub.app
